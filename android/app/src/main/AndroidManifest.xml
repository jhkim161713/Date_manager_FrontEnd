<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 구글/카카오 소셜로그인이 외부 브라우저(Custom Tabs)로 열린 뒤, 백엔드의
                 OAuth2LoginSuccessHandler가 datemanager://oauth/callback?token=... 으로 리다이렉트하면
                 이 intent-filter가 그 요청을 받아 앱으로 되돌아오게 한다(2026-09-01, @capacitor/app의
                 appUrlOpen 리스너와 짝을 이룸 - "구글/카카오 소셜로그인 딥링크" 미해결 항목 해결). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="datemanager" android:host="oauth" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 홈탭 "내 주변" 추천, 날씨, 큐레이션 위치 필터가 navigator.geolocation을 쓰는데,
         이 권한이 없으면 웹뷰의 onGeolocationPermissionsShowPrompt가 항상 거부로 끝나서
         위치 기반 기능이 전부 폴백(기본 좌표)으로만 동작한다(2026-08-24 실기기 테스트로 발견). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
</manifest>
